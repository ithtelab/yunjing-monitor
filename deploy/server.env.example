# 复制为 server.env 后再填写真实值。不要把真实密钥提交到代码仓库。
ADDR=127.0.0.1:3000
AUTH_SECRET=replace-with-a-random-64-character-secret
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-admin-password
DATA_PATH=/www/wwwroot/monitor-party/data/server.json
PUBLIC_URL=https://monitor.example.com
OFFLINE_WAIT=60s
MAX_NODES=2000

