# 复制为项目根目录 .env 后由 docker compose 读取（变量替换）
# 不要提交真实密钥到公开仓库

SERVER_BINARY=release/vps-server-linux-amd64
HOST_BIND=127.0.0.1
HOST_PORT=1314

ADDR=0.0.0.0:1314
AUTH_SECRET=replace-with-a-random-64-character-secret
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-admin-password
DATA_PATH=/app/data/server.json
PUBLIC_URL=https://monitor.example.com
OFFLINE_WAIT=60s
MAX_NODES=2000
