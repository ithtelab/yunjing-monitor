# 云镜监控 / Yunjing Monitor / 1Panel Compose example
PUBLIC_URL=https://monitor.example.com
HOST_BIND=127.0.0.1
HOST_PORT=1314

ADMIN_USER=admin
ADMIN_PASS=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

DATA_PATH=/app/data/server.json
STORE_DRIVER=sqlite
DB_PATH=/app/data/server.db
OFFLINE_WAIT=60s
MAX_NODES=2000
PUBLIC_MONITOR_DETAILS=false

UPDATE_REPOSITORY=ithtelab/yunjing-monitor
UPDATE_ENABLED=false
GITHUB_TOKEN=

# Generate independently from AUTH_SECRET: openssl rand -base64 48
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_AN_INDEPENDENT_HIGH_ENTROPY_KEY
BACKUP_DIR=/app/data/backups
BACKUP_INTERVAL=24h
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
